\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Proposed pipeline division of labor. Posit8/16 concentrates precision where activation distributions are dense. Flat128 accumulates exact 256-bit intermediate products at the wide stage. Parameters are stored at uniform flat128 precision. All three stages share one principle: round once, explicitly, at a defined boundary, and never invisibly inside an operation.}}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:pipeline}{{2}{4}{Proposed pipeline division of labor. Posit8/16 concentrates precision where activation distributions are dense. Flat128 accumulates exact 256-bit intermediate products at the wide stage. Parameters are stored at uniform flat128 precision. All three stages share one principle: round once, explicitly, at a defined boundary, and never invisibly inside an operation}{figure.caption.3}{}}
